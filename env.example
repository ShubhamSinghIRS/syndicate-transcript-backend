# === App ===
ENVIRONMENT=development

# === Database ===
DATABASE_URL=

# === Auth / JWT ===
JWT_SECRET=
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
COOKIE_SECURE=true

# === CORS / Frontend ===
CORS_ALLOWED_ORIGINS=
FRONTEND_BASE_URL=

# === API docs (Swagger/ReDoc/OpenAPI) ===
ENABLE_DOCS=false

# === Reverse proxy ===
TRUST_PROXY_HEADERS=true

# === Email (SendGrid) ===
SENDGRID_API_KEY=
FROM_EMAIL=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=console

# === Secrets (encryption / hashing) ===
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=
# Generate: openssl rand -hex 32
EMAIL_HASH_SECRET=
# Generate: openssl rand -hex 32
OTP_HASH_SECRET=

# === Payment (Razorpay) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# === Transcript ingest (Infollion backend) ===
SYNDICATE_INBOUND_API_KEY=

# === Storage (Linode Object Storage) ===
LINODE_ACCESS_KEY=
LINODE_SECRET_KEY=
LINODE_REGION=
LINODE_BUCKET=
LINODE_ENDPOINT=
