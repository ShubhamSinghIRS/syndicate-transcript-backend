# === App ===
ENVIRONMENT=development

# === Database ===
# If running via docker-compose (docker-compose.yml / docker-compose.dev.yml),
# host must be "postgres" (the compose service name), e.g.:
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# If pointing at Neon or another external Postgres instead, use its connection
# string directly and leave POSTGRES_USER/PASSWORD/DB below unset.
DATABASE_URL=

# Only needed when docker-compose is running its own Postgres container
# (must match the credentials used in DATABASE_URL above).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# === Auth / JWT ===
JWT_SECRET=
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
COOKIE_SECURE=true

# === CORS / Frontend ===
CORS_ALLOWED_ORIGINS=
FRONTEND_BASE_URL=

# === API docs (Swagger/ReDoc/OpenAPI) ===
ENABLE_DOCS=false

# === Reverse proxy ===
TRUST_PROXY_HEADERS=true

# === Email (SendGrid) ===
SENDGRID_API_KEY=
FROM_EMAIL=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=console

# === Secrets (encryption / hashing) ===
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=
# Generate: openssl rand -hex 32
EMAIL_HASH_SECRET=
# Generate: openssl rand -hex 32
OTP_HASH_SECRET=

# === Payment (Razorpay) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# === Transcript ingest (Infollion backend) ===
SYNDICATE_INBOUND_API_KEY=

# === Domains API (Infollion backend) ===
INFOLLION_DOMAINS_API_URL=https://sandbox.infollion.com/api/v1/domains
INFOLLION_API_KEY=

# === Storage (Linode Object Storage) ===
LINODE_ACCESS_KEY=
LINODE_SECRET_KEY=
LINODE_REGION=
LINODE_BUCKET=
LINODE_ENDPOINT=
