# Syndicate Transcript Backend - Auth service - port 8000

# Defaults to "production" on purpose - a deployment that forgets to set this
# gets the safe behavior (e.g. OTPs/reset links are never written to logs even
# if email delivery is misconfigured), not the dev-convenience one. Set this
# to "development" explicitly in your local .env.
ENVIRONMENT=development

# DATABASE_URL_DEV: managed Postgres connection string (e.g. Aiven). SSL is required.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# Generate: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime in minutes. Kept short since this is the credential
# sent on every request - a refresh token (see below) is what keeps the user
# logged in beyond this. Default: 15
ACCESS_TOKEN_EXPIRY_MINUTES=15
# Refresh token lifetime in days - stored server-side (sessions table) as a
# hash, delivered to the client as an httpOnly cookie. Default: 30
REFRESH_TOKEN_EXPIRY_DAYS=30
# Whether the refresh-token cookie gets the Secure flag (HTTPS only). Keep
# true in production (required for cross-site cookies to work at all - browsers
# reject SameSite=None without Secure). Set false only for local http dev,
# which falls back to SameSite=Lax (same-origin only).
COOKIE_SECURE=true

# Comma-separated list of origins the browser is allowed to send requests from.
# Must match the URL the syndicate-client frontend is served at.
# Example: https://syndicate.infollion.com  or  http://localhost:5173 for local dev
CORS_ALLOWED_ORIGINS=

# Base URL of the frontend, used to build the password-reset link emailed to users.
# Example: https://syndicate.infollion.com  or  http://localhost:5173 for local dev
FRONTEND_BASE_URL=

# Swagger UI (/docs), ReDoc (/redoc), and the raw OpenAPI schema (/openapi.json)
# are disabled by default - they expose the entire API surface with no auth
# of their own. Set true for local dev/staging only.
ENABLE_DOCS=false

# True in every real deployment - this app sits behind Render's proxy, which
# sets X-Forwarded-For to the real client IP on every request. IP-based rate
# limits (login/OTP/register throttling) read that header when this is true.
# Only set to false if this app ever receives connections directly from the
# internet with no trusted proxy in front - trusting the header in that case
# would let a client fake any IP and dodge rate limiting entirely.
TRUST_PROXY_HEADERS=true

# SendGrid used to send OTP, password-reset, and receipt emails. If left empty,
# emails are logged instead of sent (useful for local dev without a real mailbox).
# Uses SendGrid's HTTP API (not SMTP) - some hosts (e.g. Render) block outbound SMTP.
# FROM_EMAIL must be a SendGrid-verified single sender (or domain-authenticated address).
SENDGRID_API_KEY=
FROM_EMAIL=

# Logging: level (DEBUG|INFO|WARNING|ERROR) and format (json for prod, console for dev)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Encrypts users.email at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes all existing encrypted emails unreadable - back it up.
EMAIL_ENCRYPTION_KEY=
# HMAC pepper for the deterministic email lookup hash. Generate: openssl rand -hex 32
# Rotating this breaks lookup for existing users (their email_hash won't match anymore).
EMAIL_HASH_SECRET=
# HMAC pepper for hashing OTP codes at rest. Generate: openssl rand -hex 32
# Safe to rotate anytime - only in-flight OTP codes (a few minutes old) are invalidated.
OTP_HASH_SECRET=

# Separate backend service that signs S3 (Linode Object Storage) URLs for
# transcript view/download. Endpoint path and auth header format are TBD -
# placeholders until that service's real contract is confirmed.
SIGNING_SERVICE_URL=
SIGNING_SERVICE_API_KEY=

# Razorpay test-mode credentials for checkout (see src/services/payment/core.py).
# key_id/key_secret come from the Razorpay dashboard's API Keys section;
# webhook secret is set when the webhook endpoint is registered there.
# Leave empty until you have real test-mode values - order creation will
# fail with a clear "payments not configured" error until then.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Currency orders are created in. Must be enabled on the Razorpay account.
PAYMENT_CURRENCY=USD

# Shared secret for the Infollion backend's server-to-server transcript ingest
# (POST/PATCH /api/internal/transcripts, sent as the `x-api-key` header). Must match
# the Infollion backend's SYNDICATE_SERVICE_API_KEY. Leave empty to disable ingest
# (all ingest requests will then be rejected with 401).
SYNDICATE_INBOUND_API_KEY=

# Linode Object Storage (S3-compatible) — the SAME bucket/credentials the Infollion
# backend uses. Transcript files are uploaded there (private, under infollion-v2/);
# these creds let this service mint short-lived presigned GET URLs to serve them.
# READ-ONLY use here (get_object only). Use the identical values from the Infollion
# backend's env (LINODE_*). Leave empty to fall back to the dev placeholder PDF.
LINODE_ACCESS_KEY=
LINODE_SECRET_KEY=
LINODE_REGION=
LINODE_BUCKET=
LINODE_ENDPOINT=
